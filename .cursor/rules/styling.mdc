## UI Components Rules (Shape: Pill & Soft)

### Buttons (Pill Shape)

```tsx
// Primary Button - Strong CTA
<Pressable className="bg-brand active:bg-brand-dark rounded-full h-14 px-8 items-center justify-center shadow-md">
  <Text className="text-white font-semibold text-base">번역하기</Text>
</Pressable>

// Secondary Button - Less emphasized
<Pressable className="bg-brand-light active:bg-brand-light/80 rounded-full h-12 px-6 items-center justify-center">
  <Text className="text-brand-dark font-semibold text-base">취소</Text>
</Pressable>

// Text Button / Ghost
<Pressable className="rounded-full h-10 px-4 items-center justify-center">
  <Text className="text-brand-dark font-medium text-sm">더보기</Text>
</Pressable>

// Floating Action Button (FAB)
<Pressable className="bg-brand active:bg-brand-dark rounded-full w-14 h-14 items-center justify-center shadow-lg absolute bottom-6 right-6">
  <Ionicons name="add" size={24} color="white" />
</Pressable>
```

### Cards (Soft Rounded)

```tsx
// Standard Card
<View className="bg-bg-surface rounded-3xl p-6 shadow-sm">
  <Text className="text-lg font-semibold text-text-main">{title}</Text>
  <Text className="text-sm text-text-sub mt-1">{date}</Text>
  <Text className="text-base text-text-main mt-3 leading-relaxed">{content}</Text>
</View>

// Vocabulary Card
<View className="bg-bg-surface rounded-3xl p-6 shadow-sm shadow-brand/10">
  <Text className="text-xl font-bold text-text-main">{word}</Text>
  <Text className="text-brand text-sm mt-1">{yomikata}</Text>
  <Text className="text-text-sub mt-2">{meaning}</Text>
</View>

// Highlighted Card (with accent)
<View className="bg-bg-surface rounded-3xl p-6 shadow-sm border-l-4 border-accent">
  <Text className="text-lg font-semibold text-text-main">원포인트 문법</Text>
  <Text className="text-base text-text-main mt-2">{grammarPoint}</Text>
</View>
```

### Inputs

```tsx
// Text Input
<TextInput
  className="bg-brand-light/50 rounded-2xl px-4 h-14 text-text-main text-base focus:ring-2 focus:ring-brand"
